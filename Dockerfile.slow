# PROVIDED: the CI Dockerfile everybody is afraid of. Read it, then measure it with ./measure.sh Dockerfile.slow
FROM python:3.12-slim
WORKDIR /app
COPY . /app
RUN apt-get update
RUN apt-get install -y --no-install-recommends gcc libpq-dev
RUN pip install -r pollie/requirements.txt
CMD ["uvicorn", "pollie.pollie.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
